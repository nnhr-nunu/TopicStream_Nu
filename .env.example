# Google AI Studio で発行したキーを入れる。前後に " を付けない。実キーはコミットしない。
# https://aistudio.google.com/apikey
# Vercel では Production と Preview の両方に入れ、変更後は再デプロイする。
GEMINI_API_KEY=

# YouTube ライブチャット（任意）。無いときはアプリ内のテストコメントを使う。
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# みんなのトピック図鑑（任意）。Upstash Redis の REST URL とトークン。
# Vercel の Storage → Marketplace で Upstash Redis をつなぐと KV_REST_API_URL / KV_REST_API_TOKEN が自動で入る。
# 無いときはサーバーのメモリだけに記録する（再起動で消える。同梱の図鑑と各自の端末の記録は使える）。
KV_REST_API_URL=
KV_REST_API_TOKEN=
